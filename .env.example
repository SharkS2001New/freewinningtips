# Copy to .env.local for local development:
#   cp .env.example .env.local
#
# Required on PRODUCTION: exactly 24 characters.
# Must match admin BLOG_CACHE_CLEAR_KEY and pitchpredictions.com.
# Used by:
#   GET /api/clear-blog-cache/[slug]   — clear one blog post file cache
#   GET /api/clear-blog-list-cache     — clear blog list + homepage snippet
BLOG_CACHE_CLEAR_KEY=xxxxxxxxxxxxxxxxxxxxxxxx

# Optional: prediction page JSON caches (POST /api/clear-cache)
CACHE_CLEAR_KEY=xxxxxxxxxxxxxxxxxxxxxxxx
